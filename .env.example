# Copy this file to .env and fill it in on each computer.
# .env is gitignored. Leave the values here blank.

# MongoDB Atlas connection string. Not used by npm run dev:local.
MONGODB_URI=

# Database name. Production uses cyclebuddy. Previews use cyclebuddy-preview.
MONGODB_DB=cyclebuddy

# Long random string that signs login cookies. Make a new one on each computer.
SESSION_SECRET=

# Google sign-in. The server checks the ID token against this client id.
GOOGLE_CLIENT_ID=

# Optional. The server signs in with the ID token and GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_SECRET=

# Set to 1 when the app is behind a proxy (Vercel). Leave unset on your own computer.
# TRUST_PROXY=1

# Optional public site origin, used for cross-site checks.
# APP_ORIGIN=
